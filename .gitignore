# ── Secrets — NEVER commit ────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
*.pfx

# ── Raw biometric data — NEVER commit (GDPR Art. 9 / BIPA / CUBI) ─────────
# Recorded API responses in fixtures/*.json and fixtures/*.pdf are derived,
# not biometric, and are committed on purpose — they are the record of what
# the API actually returned. Everything under fixtures/synthetic/ is invented
# and regenerable with `make seed`, so it stays out of the repo.
fixtures/raw/
fixtures/synthetic/
fixtures/derived/
fixtures/units.log
fixtures/masks/
benchmark/constellation_*.png
benchmark/captures/**/*.jpg
benchmark/captures/**/*.jpeg
benchmark/captures/**/*.png
benchmark/captures/**/*.mp4
benchmark/captures/**/*.mov
!benchmark/captures/**/.gitkeep

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# ── Node ──────────────────────────────────────────────────────────────────
node_modules/
dist/
.vite/
npm-debug.log*

# ── OS / editor ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
*.swp

# ── Build artefacts ───────────────────────────────────────────────────────
out/
*.local
context.original.md.bak

# Markdown — kept local, not committed
*.md

# Unsent sponsor correspondence — personal, not part of the deliverable
docs/outbox/
