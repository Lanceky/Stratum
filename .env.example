# STRATUM — environment template
# Copy to .env and fill in. NEVER commit .env.
# Status of each credential is tracked in README.md § Credential status.

# ─────────────────────────────────────────────────────────────────────────
# RUNTIME MODE — read this before changing
# ─────────────────────────────────────────────────────────────────────────
# replay = never call a real API, load from fixtures/     (DEFAULT in dev)
# auto   = use fixture if present, else call real API and record it
# live   = always call the real API                       (costs units)
STRATUM_API_MODE=replay

# Hard ceiling on Perfect Corp units per process. Aborts when exceeded.
# A runaway loop at 22 units/call empties a 500-unit grant in under a minute.
UNIT_BUDGET_CEILING=200

# ─────────────────────────────────────────────────────────────────────────
# PERFECT CORP — Tier 0, the sensor
# https://yce.makeupar.com/ai-api  ·  redeem: yce.perfectcorp.com/api-console/en/redeem-code/
# Auth is an RSA token exchange, NOT a plain key header (verified against the
# live API). PERFECTCORP_SECRET_KEY is an RSA *public* key in base64 DER, shown
# beside the API key in the console — it is not a password. The client encrypts
# `client_id=<id>&timestamp=<epoch_ms>` under it, POSTs that to
# /s2s/v1.0/client/auth, and sends the returned token as `Bearer`.
# Sending PERFECTCORP_API_KEY directly returns 401 InvalidApiKey.
# ─────────────────────────────────────────────────────────────────────────
PERFECTCORP_API_KEY=
PERFECTCORP_SECRET_KEY=
PERFECTCORP_BASE_URL=https://yce-api-01.makeupar.com

# ─────────────────────────────────────────────────────────────────────────
# XANO — Tier 0, system of record
# ─────────────────────────────────────────────────────────────────────────
# INSTANCE_URL   instance settings — e.g. https://x8ki-abcd-efgh.n7.xano.io
# API_GROUP_BASE Library > APIs > <your group> — instance URL + /api:<hash>.
#                Does not exist until you create an API group (Step 3).
# AUTH_TOKEN     Metadata API personal access token: profile icon > Instances >
#                gear > Metadata API > Manage Access Tokens. Shown once.
XANO_INSTANCE_URL=
XANO_API_GROUP_BASE=
XANO_AUTH_TOKEN=

# ─────────────────────────────────────────────────────────────────────────
# FOXIT — Tier 0, the agent boundary
# NOTE: two products, two DIFFERENT auth schemes. This trips everyone up.
#   PDF Services → client_id / client_secret HEADERS (not OAuth)
#   eSign        → OAuth2 bearer token
# Sending an eSign bearer token to PDF Services returns a 401 that reads
# exactly like a bad key, so the half hour goes on rotating credentials that
# were never wrong.
#
# PDF Services is self-serve and free: app.developer-api.foxit.com/sign-up
# gives 500 credits a year with no card. eSign has no self-serve sandbox —
# email theodore_castro@foxitsoftware.com.
#
# Leave these blank and the agent toolset still runs, from seeded stand-ins,
# and says so on screen. The refusal does not depend on Foxit being reachable.
# ─────────────────────────────────────────────────────────────────────────
FOXIT_CLIENT_ID=
FOXIT_CLIENT_SECRET=
# Either form works — the trailing /api is normalised away.
FOXIT_PDF_BASE_URL=https://na1.fusion.foxit.com/pdf-services
# replay (default) | auto | live. Falls back to STRATUM_API_MODE if unset.
FOXIT_API_MODE=
# Guards the 500-credit grant. Counted apart from UNIT_BUDGET_CEILING, which
# guards Perfect Corp — two unrelated quotas must not share one counter.
FOXIT_CREDIT_CEILING=400
FOXIT_ESIGN_BASE_URL=https://na1.foxitesign.foxit.com/api
FOXIT_ESIGN_CLIENT_ID=
FOXIT_ESIGN_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────────
# NUTRIENT DWS — Tier 1, the attestation renderer
# Auth is a single credential sent in the `Authorization` header. There is
# no exchange step and no second identity header, unlike Foxit and Doctavian
# respectively.
# Key: https://dashboard.nutrient.io/api/
#
# Credits are UNMETERED under the sponsor grant, so /build runs live rather
# than from a stand-in. Recordings still exist so the suite works offline.
#
# ONE KEY PER PRODUCT, and they are not interchangeable. The extraction key on
# a processor endpoint returns a bare 403 — identical to what a revoked key
# returns, so a mis-set key looks like a dead account. `make nutrient` probes
# each against its own endpoint for exactly that reason, using calls that are
# free: /analyze_build for the processor, and a deliberately schema-less
# extraction request whose 400 proves auth without paying for a parse.
#
# The "For Evaluation Purposes Only" watermark is lifted — verified against a
# probe PDF containing no evaluation markers. Worth re-checking if the grant is
# ever reissued: it would land on the attestation, the one document here whose
# whole purpose is to be relied upon.
# ─────────────────────────────────────────────────────────────────────────
NUTRIENT_PROCESSOR_API=
NUTRIENT_DATA_EXTRACTION_API=
# Present for completeness. Not wired: PDF/UA is an output type on /build, so
# the attestation gets an accessible form without a fourth integration.
NUTRIENT_ACCESSIBILITY_API=
NUTRIENT_BASE_URL=https://api.nutrient.io

# ─────────────────────────────────────────────────────────────────────────
# NAME.COM — Tier 1, verifiable origin
# HTTP Basic: username + token. TWO separate token sets.
# Sandbox username is "<yourname>-test" with its own Development/Test token.
# ⚠️ Sandbox DNS does NOT publicly resolve — the live `dig` needs production.
# ─────────────────────────────────────────────────────────────────────────
NAMECOM_USERNAME=
NAMECOM_TOKEN=
NAMECOM_TEST_USERNAME=
NAMECOM_TEST_TOKEN=
NAMECOM_BASE_URL=https://api.dev.name.com
NAMECOM_PROD_BASE_URL=https://api.name.com
# The one production domain used for the live `dig` demo beat (Step 10).
STRATUM_ATTEST_DOMAIN=

# ─────────────────────────────────────────────────────────────────────────
# SERPAPI — Tier 2, live-world corroboration
# 250 searches/month, 50/hour. Identical queries within 1 hour are FREE
# and do not count — warm the cache before recording the video.
# ─────────────────────────────────────────────────────────────────────────
SERPAPI_KEY=

# ─────────────────────────────────────────────────────────────────────────
# DOCTAVIAN — Tier 2, attestation certificate
# Credentials are issued MANUALLY — email hello@doctavian.com.
#
# Auth is NOT OAuth2 client credentials, and NOT an API key alone. The gateway
# requires BOTH a key and a caller identity (the OpenAPI security block lists
# bearerAuth and apiKeyHeader in the same object, which means AND):
#   X-Api-Key alone    -> 401 "Authorization header is missing"
#   bearer alone       -> 401 "ApiKeyNotFound"
# The public OAuth2 proxy accepts only authorization_code / refresh_token, so
# it needs a browser and cannot be automated. Backends send a service token —
# an opaque AES-encrypted JWT ("CfDJ8...") that only the server can mint. On the
# demo environment /v1/common/service/token is not routed, so take it from the
# Postman collection in the credential email or from demo.portal.doctavian.com.
DOCTAVIAN_BASE_URL=https://demo.api.doctavian.com
DOCTAVIAN_API_KEY=
DOCTAVIAN_SERVICE_TOKEN=
DOCTAVIAN_TEAM="Team Stratum"
DOCTAVIAN_EMAIL=

# ─────────────────────────────────────────────────────────────────────────
# VERIFIER SIDECAR
# ─────────────────────────────────────────────────────────────────────────
VERIFIER_URL=http://localhost:8000
VERIFIER_SHARED_SECRET=

# ─────────────────────────────────────────────────────────────────────────
# ONE HUMAN, ONE CLAIM (web3)
# ─────────────────────────────────────────────────────────────────────────
# The key that signs claims so a contract can `ecrecover` the issuer. Generate
# a fresh one — a shared demo key would let anyone mint claims in your name:
#   python -c "from eth_account import Account; a=Account.create(); print(a.key.hex(), a.address)"
STRATUM_SIGNING_KEY=

# Salts the nullifier that makes a person's claims unlinkable across campaigns.
# It must be stable across restarts: a nullifier that changed on restart would
# let the same person claim twice. Leaking it retroactively links every
# nullifier ever issued, so treat it as a long-lived secret.
STRATUM_NULLIFIER_SECRET=
